// agent-snap 설정 예시입니다. 이 파일을 사용자 설정 폴더에 agent-snap.jsonc로 복사해 값을 채웁니다.
// 설정 폴더: Windows는 %APPDATA%\agent-snap, 그 밖은 $XDG_CONFIG_HOME/agent-snap(없으면 ~/.config/agent-snap)입니다.
// 환경 변수 AGENT_SNAP_CONFIG_DIR로 폴더를 직접 지정할 수 있습니다.
// 키는 이 파일이 아니라 같은 폴더의 credentials.jsonc에 둡니다. 실제 주소와 키를 이 예시 파일에 적지 않습니다.
// base_url은 OpenAI 호환 기본 주소이며 보통 /v1까지 포함합니다(경로 여부는 검증하지 않습니다).
{
  "target_language": "ko",
  "endpoints": [
    {
      "name": "<엔드포인트 이름 1>",
      "base_url": "https://<엔드포인트 호스트 1>/v1",
      "kind": "openai",
      // kind: openai | openrouter | ollama | vllm | llamacpp | lmstudio
      "models": [
        {
          "name": "<모델 이름 1>",
          "id": "<서버에 보낼 모델 id 1>",
          // "reasoning": "off", // off | low | medium | high
          // "context_window": 65536, // 토큰. 생략 시 65536. max_tokens(생성 길이)와 다름
          // "sampling": { "temperature": 0.2, "top_p": 0.95, "max_tokens": 4096 },
          // "extra": { "keep_alive": 0 }
        }
      ]
    },
    {
      "name": "<엔드포인트 이름 2>",
      "base_url": "http://<엔드포인트 호스트 2>/v1",
      "kind": "llamacpp",
      "models": [
        {
          "name": "<모델 이름 2>",
          "id": "<서버에 보낼 모델 id 2>"
        }
      ]
    }
  ],
  // "sampling": { "temperature": 0.2, "top_p": 0.95, "max_tokens": 4096 },
  "http": {
    // 기본값: retries 3, backoff_min 1, backoff_max 30, retry_after_max 60,
    // connect_seconds 10, header_wait_seconds 300, stream_idle_seconds 120
    // "retries": 3,
    // "backoff_min": 1,
    // "backoff_max": 30,
    // "retry_after_max": 60,
    // "connect_seconds": 10,
    // "header_wait_seconds": 300,
    // "stream_idle_seconds": 120
  }
}
